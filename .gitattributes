# Auto normalize line endings for all text files
* text=auto

# Explicitly set line endings for source files
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
